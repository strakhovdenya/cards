{
  "branchTemplate": "task/ISSUE-{issue}-{slug}",
  "githubProject": 1,
  "apps": [
    {
      "name": "cards",
      "path": ".",
      "install": [{ "argv": ["npm", "install"], "cwd": "." }],
      "dependencySync": [{ "argv": ["npm", "install", "--ignore-scripts"], "cwd": "." }],
      "gate": [
        { "argv": ["node", "node_modules/eslint/bin/eslint.js", ".", "--max-warnings=0"], "cwd": "." },
        { "argv": ["node", "node_modules/prettier/bin/prettier.cjs", "--check", "src"], "cwd": "." },
        { "argv": ["node", "node_modules/typescript/bin/tsc", "--noEmit"], "cwd": "." },
        { "argv": ["node", "node_modules/vitest/vitest.mjs", "run"], "cwd": "." },
        { "argv": ["node", "node_modules/next/dist/bin/next", "build"], "cwd": "." }
      ]
    }
  ],
  "docOnlyPathPatterns": ["**/*.md", "**/docs/"],
  "protectedPaths": [".claude/", "scripts/", ".github/", ".husky/", ".git/", "docs/"],
  "labels": { "humanNeeded": "ralph-needs-db-change", "calibration": "calibrate" },
  "verifier": {
    "goldenDir": ".github/verifier/golden",
    "checks": [
      "spec-approval",
      "affects-scope",
      "computed-items",
      "test-tampering-scan",
      "references",
      "ci-checks",
      "allowed-model"
    ]
  },
  "judge": { "enabled": true },
  "skillRules": [
    {
      "path": "src",
      "extensions": [".test.ts", ".test.tsx"],
      "label": "tests (vitest)",
      "skills": ["vitest"]
    },
    {
      "path": "src/components",
      "extensions": [".tsx"],
      "label": "frontend components",
      "skills": [
        "vercel-react-best-practices",
        "material-ui-styling",
        "material-ui-nextjs",
        "ui-ux-pro-max"
      ]
    },
    {
      "path": "src/app",
      "extensions": [".tsx"],
      "label": "frontend pages",
      "skills": [
        "vercel-react-best-practices",
        "material-ui-styling",
        "material-ui-nextjs",
        "ui-ux-pro-max"
      ]
    },
    {
      "path": "src/hooks",
      "extensions": [".ts", ".tsx"],
      "label": "react hooks",
      "skills": ["vercel-react-best-practices"]
    }
  ],
  "ruleFiles": ["CLAUDE.md"],
  "overlays": { "prd": "prd.json", "plan": "plan.json" },
  "docs": { "prd": "project-management/prd", "plans": "project-management/plan", "adr": "project-management/DECISIONS.md" },
  "hooks": {
    "lint": [
      { "paths": ["**/*.{ts,tsx,js,jsx}"], "command": { "argv": ["node", "node_modules/prettier/bin/prettier.cjs", "--write", "{file}"], "cwd": "." } },
      { "paths": ["**/*.{ts,tsx,js,jsx}"], "command": { "argv": ["node", "node_modules/eslint/bin/eslint.js", "--fix", "{file}"], "cwd": "." } }
    ],
    "typecheck": [
      { "paths": ["**/*.{ts,tsx}"], "command": { "argv": ["node", "node_modules/typescript/bin/tsc", "--noEmit"], "cwd": "." } }
    ]
  },
  "agentEnvironment": [
    "No running next dev server; starting a dev server in the background is forbidden.",
    "No access to the real Supabase (neither database nor auth).",
    "No browser and no Playwright tools."
  ],
  "sandbox": {
    "image": "cards-ralph-sandbox:local",
    "nodeVersion": "22",
    "claudeCodeVersion": "2.1.283",
    "allowedHosts": ["registry.npmjs.org", "api.anthropic.com", "codeload.github.com"]
  },
  "ralph": { "enabled": true, "techDebtTrackerIssue": 1, "humanNeededVerdict": "BLOCKED-DB-CHANGE", "stepBudgets": { "self-review": 4, "code-review": 2 } }
}
