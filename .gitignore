# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ralph из пакета dark-factory: личный конфиг запуска (node_modules/dark-factory/ralph/README.md)
.ralph/

# прежний локальный Ralph (удалён): личные файлы остаются на диске до осознанного переноса
.claude/ralph/config.json
.claude/ralph/state.json
.claude/ralph/run.lock
.ralph-runs/

# claude code local overrides + hook logs
.claude/settings.local.json
scripts/*.log

.vercel
.env*
*/skills/metaskills

# dark-factory setup — управляемые копии базового набора v0.1.3 и их manifest. Создаются
# postinstall-ом установленного пакета (node_modules/dark-factory/bin/setup.js); setup требует
# каждый путь поимённо, широкая маска не принимается. При смене версии фабрики список
# сверяется заново (шаг 5 docs/connecting-a-project.md на теге релиза).
.claude/.factory-installed.json
.claude/skills/prd
.claude/skills/plan
.claude/skills/issues
.claude/skills/task-lifecycle
.claude/skills/epic-discovery
.claude/skills/adr
.claude/skills/js-conventions
.claude/skills/js-gof
.claude/skills/js-data-structures
.claude/skills/error-handling
.claude/skills/modern-javascript
.claude/skills/data-structures
.claude/agents/research.md
.claude/agents/codebase-scan.md
.claude/agents/verify.md
.claude/agents/pr-writer.md
