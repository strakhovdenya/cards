# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ralph loop (autonomous agent) runtime files — see .claude/ralph/README.md
.claude/ralph/config.json
.claude/ralph/state.json
.claude/ralph/run.lock
.ralph-runs/

# claude code local overrides + hook logs
.claude/settings.local.json
scripts/*.log

.vercel
.env*
*/skills/metaskills

# metaskills — копии из node_modules/metaskills/skills/<name>, создаются postinstall-скриптом
# scripts/setup-metaskills.js, чтобы Claude Code и Ralph видели их как обычные skills
# (сканируют на глубину .claude/skills/<name>/SKILL.md)
.claude/skills/data-structures
.claude/skills/js-data-structures
.claude/skills/js-conventions
.claude/skills/error-handling
.claude/skills/js-gof
