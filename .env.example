# Supabase — client-side (public, safe to expose in the browser)
# Found in: Supabase dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Found in: Supabase dashboard → Settings → API → Project API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase — server-side only (used by getServiceSupabase() in src/lib/supabase.ts)
# Same URL value as NEXT_PUBLIC_SUPABASE_URL, but kept as a separate variable so that
# CI and Vercel preview environments can intentionally omit it — making getServiceSupabase()
# fail at request time rather than at build time (ADR-003). Both variables point to the same
# Supabase project URL; set both to the same value.
# Found in: Supabase dashboard → Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Found in: Supabase dashboard → Settings → API → Project API keys → service_role (secret!)
# Never expose this key in the browser or commit it to the repository.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# The Supabase user ID whose data is shown to unauthenticated guests in /demo
# Found in: Supabase dashboard → Authentication → Users → copy the UUID of the demo user
DEMO_USER_ID=your-demo-user-uuid-here
